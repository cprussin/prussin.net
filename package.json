{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "fix:format": "prettier --write .",
    "fix:lint": "eslint --fix .",
    "install:modules": "[ $CI ] && true || bun install",
    "test:format": "run-jest --selectProjects format",
    "test:lint": "run-jest --selectProjects lint",
    "turbo": "[ ! -d node_modules ] && bun install --frozen-lockfile; node_modules/.bin/turbo"
  },
  "devDependencies": {
    "@cprussin/eslint-config": "^5.1.1",
    "@cprussin/jest-config": "^3.1.3",
    "@cprussin/prettier-config": "^3.0.1",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3"
  },
  "overrides": {
    "eslint-plugin-tailwindcss": "3.18.2"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
