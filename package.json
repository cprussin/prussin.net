{
  "catalog": {
    "@biomejs/biome": "^2.5.14",
    "@cprussin/tsconfig": "^5.0.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.0",
    "autoprefixer": "^10.4.22",
    "next": "^16.0.10",
    "postcss": "^8.5.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": "^24.0.0"
  },
  "name": "prussin.net",
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "build:install-modules": "[ $CI$CLAUDE_CODE_REMOTE ] && true || bun install",
    "fix:lint": "biome check --max-diagnostics=none --write",
    "test:dependencies": "bun outdated -r",
    "test:lint": "biome check --max-diagnostics=none",
    "turbo": "[ ! -d node_modules ] && bun install --frozen-lockfile; node_modules/.bin/turbo"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
