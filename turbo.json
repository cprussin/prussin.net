{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["BIOME_BINARY", "FORCE_COLOR"],
  "tasks": {
    "//#build": {
      "dependsOn": ["//#build:install-modules"]
    },
    "//#build:install-modules": {
      "inputs": ["**/package.json", "bunfig.toml", "!**/.next/**"],
      "outputs": ["bun.lock"]
    },
    "//#fix": {
      "with": ["//#fix:lint"]
    },
    "//#fix:lint": {
      "cache": false,
      "dependsOn": ["//#build"]
    },
    "//#pull:env": {
      "cache": false,
      "dependsOn": ["//#build"],
      "outputs": [".env.local"]
    },
    "//#test": {
      "with": ["//#test:dependencies", "//#test:lint"]
    },
    "//#test:dependencies": {
      "cache": false,
      "dependsOn": ["//#build"]
    },
    "//#test:lint": {
      "dependsOn": ["//#build"]
    },
    "build": {
      "dependsOn": ["//#build", "pull:env", "^build"],
      "env": ["VERCEL_ENV"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.test.*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "pull:env": {
      "cache": false,
      "dependsOn": ["//#build"],
      "outputs": [".env.local"]
    },
    "start:dev": {
      "cache": false,
      "dependsOn": ["//#build", "pull:env", "^build"],
      "persistent": true
    },
    "start:prod": {
      "cache": false,
      "dependsOn": ["//#build", "pull:env", "build"],
      "persistent": true
    },
    "test": {
      "with": ["test:types", "test:unit"]
    },
    "test:types": {
      "dependsOn": ["//#build", "^build"]
    },
    "test:unit": {
      "dependsOn": ["//#build", "^build"]
    }
  },
  "ui": "tui"
}
