{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "with": ["build:app"]
    },
    "build:app": {
      "dependsOn": ["//#build", "pull:env", "^build"],
      "env": ["VERCEL_ENV"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.test.*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build:next-types": {
      "dependsOn": ["//#build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.test.*"]
    },
    "test:types": {
      "dependsOn": ["//#build", "build:next-types"]
    }
  }
}
